<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Applies to every supported Android version, including API 24–27. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
